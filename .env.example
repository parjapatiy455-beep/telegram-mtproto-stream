# Telegram API Credentials (https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Channel ID where files will be stored (Must be an integer starting with -100...)
# Example: -1001234567890
BIN_CHANNEL=-1001234567890

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Base URL of this server (Used to generate links)
# For local testing: http://localhost:8000
# For production or VPS/Ngrok: https://yourdomain.com
BASE_URL=http://localhost:8000

# Optional: List of Admin Telegram User IDs separated by commas
ADMINS=
